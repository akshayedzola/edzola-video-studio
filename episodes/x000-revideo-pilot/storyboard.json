      "beats": [
        {
          "text": "Meet Sitara Foundation. A fictional skilling nonprofit with five hundred learners.",
          "do": [
            {
              "action": "show-org"
            }
          ]
        },
        {
          "text": "The programme team keeps one spreadsheet.",
          "do": [
            {
              "action": "show-sheet",
              "sheet": 0
            }
          ]
        },
        {
          "text": "Finance keeps another. M&E keeps a third.",
          "do": [
            {
              "action": "show-sheet",
              "sheet": 1
            },
            {
              "action": "show-sheet",
              "sheet": 2,
              "at": 0.55
            }
          ]
        },
        {
          "text": "Now follow one learner. She shows up in all three, spelled three different ways.",
          "pause": 0.6,
          "do": [
            {
              "action": "highlight",
              "rows": [
                1,
                2,
                3
              ],
              "at": 0.35
            }
          ]
        },
        {
          "text": "Each team updates its own copy.",
          "do": [
            {
              "action": "pulse-sheets"
            }
          ]
        },
        {
          "text": "The programme team updates her status to placed.",
          "do": [
            {
              "action": "set-cell",
              "sheet": 0,
              "row": 1,
              "col": 2,
              "value": "Placed",
              "tone": "success",
              "at": 0.5
            }
          ]
        },
        {
          "text": "M&E still has her in training.",
          "do": [
            {
              "action": "set-cell",
              "sheet": 2,
              "row": 3,
              "col": 1,
              "value": "Training",
              "tone": "warning",
              "at": 0.5
            }
