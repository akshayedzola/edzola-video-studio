        {
          "text": "And Finance has stopped her stipend.",
          "do": [
            {
              "action": "set-cell",
              "sheet": 1,
              "row": 2,
              "col": 2,
              "value": "Stopped",
              "tone": "danger",
              "at": 0.5
            }
          ]
        },
        {
          "text": "Three versions of one person. None of them wrong on its own.",
          "pause": 0.5,
          "do": [
            {
              "action": "flag",
              "text": "1 learner · 3 versions of the truth",
              "tone": "danger",
              "at": 0.2
            }
          ]
        }
