        {
          "text": "M&E says 287.",
          "say": "M&E says two hundred and eighty-seven.",
          "do": [
            {
              "action": "show-value",
              "i": 1
            }
          ]
        },
        {
          "text": "Finance says 341.",
          "say": "Finance says three hundred and forty-one.",
          "do": [
            {
              "action": "show-value",
              "i": 2
            }
          ]
