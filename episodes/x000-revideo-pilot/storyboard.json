    {
      "id": "report-conflict",
      "type": "data_storytelling",
      "chapter": "Which number goes to the funder?",
      "template": "MetricConflict",
      "notes": "Scale the single-record problem up to the indicator a funder sees.",
      "props": {
        "label": "Learners placed this quarter",
        "values": [
          {
            "team": "Programme",
            "value": "312",
            "tone": "coral"
          },
          {
            "team": "M&E",
            "value": "287",
            "tone": "yellow"
          },
          {
            "team": "Finance",
            "value": "341",
            "tone": "teal"
          }
        ],
        "question": "Which number goes to the funder?"
      },
      "beats": [
        {
          "text": "Multiply that by five hundred learners, and the quarterly report has a problem.",
          "do": [
            {
              "action": "show-label",
              "at": 0.4
