      "notes": "Open on the viewer's lived frustration, not on a definition. No logo intro.",
      "props": {
        "kicker": "Episode 0 · What is an MIS, really?",
        "title": "Why does every report start an argument?",
        "highlight": "argument",
        "subtitle": "You bought software. The numbers still don't agree."
      },
      "beats": [
        {
          "text": "Your nonprofit bought software two years ago.",
